# 统一换行符：仓库内一律存 LF，避免 Windows 检出 / 提交时产生纯 CRLF 噪音
* text=auto eol=lf

# Windows 批处理保留 CRLF，避免个别解析器对 LF 换行的兼容问题
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.pdf binary
*.db binary
